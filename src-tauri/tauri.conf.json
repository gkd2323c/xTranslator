{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "xTranslator",
  "version": "0.1.0",
  "identifier": "com.xtranslator.app",
  "build": {
    "beforeDevCommand": "echo ok",
    "beforeBuildCommand": "cd ui && npm run build",
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "xTranslator",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
